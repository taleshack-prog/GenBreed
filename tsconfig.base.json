{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@genbreedai/shared": ["./packages/shared/src/index.ts"],
      "@genbreedai/engine": ["./packages/engine/src/index.ts"]
    },
    "baseUrl": "."
  }
}
